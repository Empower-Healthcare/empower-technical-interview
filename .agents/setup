#!/usr/bin/env bash
set -euo pipefail

# Pinned base tooling for the ParcelLab development stack: the things `make
# doctor` expects to find but never installs (Go, uv, Docker). protoc,
# protoc-gen-go, protoc-gen-go-grpc and grpcurl are NOT installed here; `make
# tools` fetches them into the repository's ./bin using the pins in the
# Makefile, exactly as on a candidate's laptop. Amp may run this script more
# than once, so each step is safe to repeat.
GO_VERSION="1.27.1"
GO_SHA256="63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445"
UV_VERSION="0.12.9"
UV_SHA256="ec7a99cd05e0cd7f80243f135ce1361c76835cb0ee60055d14d20eba8eba1460"
DOCKER_VERSION="5:29.8.0-1~debian.12~bookworm"
CONTAINERD_VERSION="2.3.5-1~debian.12~bookworm"
BUILDX_VERSION="0.37.1-1~debian.12~bookworm"
COMPOSE_VERSION="5.5.1-1~debian.12~bookworm"

export PATH="/usr/local/go/bin:/usr/local/bin:${PATH}"

require_amd64_debian_12() {
  if [[ "$(dpkg --print-architecture)" != "amd64" ]]; then
    echo "Unsupported architecture: ParcelLab's pinned binary artifacts require amd64." >&2
    exit 1
  fi

  # shellcheck disable=SC1091
  source /etc/os-release
  if [[ "${ID:-}" != "debian" || "${VERSION_CODENAME:-}" != "bookworm" ]]; then
    echo "Unsupported OS: Docker package pins target Debian 12 (bookworm)." >&2
    exit 1
  fi
}

apt_install_base_tools() {
  local packages=(ca-certificates curl git gnupg make)
  local missing=()
  local package

  for package in "${packages[@]}"; do
    dpkg-query -W -f='${Status}' "${package}" 2>/dev/null | grep -q 'install ok installed' || missing+=("${package}")
  done

  if ((${#missing[@]})); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
  fi
}

install_go() {
  if ! command -v go >/dev/null 2>&1 || [[ "$(go env GOVERSION)" != "go${GO_VERSION}" ]]; then
    local archive
    archive="$(mktemp)"
    curl --fail --silent --show-error --location \
      "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o "${archive}"
    echo "${GO_SHA256}  ${archive}" | sha256sum --check --status
    sudo rm -rf /usr/local/go
    sudo tar -C /usr/local -xzf "${archive}"
    rm -f "${archive}"
  fi

  sudo ln -sfn /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sfn /usr/local/go/bin/gofmt /usr/local/bin/gofmt
}

install_uv() {
  if command -v uv >/dev/null 2>&1 && [[ "$(uv --version)" == "uv ${UV_VERSION} "* ]]; then
    return
  fi

  local archive unpack_dir
  archive="$(mktemp)"
  unpack_dir="$(mktemp -d)"
  curl --fail --silent --show-error --location \
    "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    -o "${archive}"
  echo "${UV_SHA256}  ${archive}" | sha256sum --check --status
  tar -C "${unpack_dir}" -xzf "${archive}"
  sudo install -m 0755 "${unpack_dir}/uv-x86_64-unknown-linux-gnu/uv" /usr/local/bin/uv
  sudo install -m 0755 "${unpack_dir}/uv-x86_64-unknown-linux-gnu/uvx" /usr/local/bin/uvx
  rm -rf "${archive}" "${unpack_dir}"
}

install_docker() {
  sudo install -m 0755 -d /etc/apt/keyrings
  if [[ ! -s /etc/apt/keyrings/docker.asc ]]; then
    sudo curl --fail --silent --show-error --location \
      https://download.docker.com/linux/debian/gpg \
      -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
  fi

  local repository
  repository="deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable"
  if [[ ! -f /etc/apt/sources.list.d/docker.list ]] || ! grep -Fxq "${repository}" /etc/apt/sources.list.d/docker.list; then
    echo "${repository}" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
  fi

  local expected=(
    "docker-ce=${DOCKER_VERSION}"
    "docker-ce-cli=${DOCKER_VERSION}"
    "containerd.io=${CONTAINERD_VERSION}"
    "docker-buildx-plugin=${BUILDX_VERSION}"
    "docker-compose-plugin=${COMPOSE_VERSION}"
  )
  local spec package wanted installed needs_install=0
  for spec in "${expected[@]}"; do
    package="${spec%%=*}"
    wanted="${spec#*=}"
    installed="$(dpkg-query -W -f='${Version}' "${package}" 2>/dev/null || true)"
    [[ "${installed}" == "${wanted}" ]] || needs_install=1
  done

  if ((needs_install)); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      --allow-downgrades "${expected[@]}"
  fi
}

warm_project_dependencies() {
  if [[ -f go.mod ]]; then
    go mod download
  fi
  if [[ -f pricing/uv.lock ]]; then
    (cd pricing && uv sync --frozen)
  fi
  if [[ -f Makefile ]]; then
    make tools
  fi
}

verify_tools() {
  # `make doctor` checks the base tools, compose, the engine, and the ./bin
  # toolchain against the Makefile pins. The engine is expected to be DOWN
  # here: the supervised dockerd starts from .agents/resume after setup, and
  # nothing started by setup survives into the snapshot anyway. Any MISSING or
  # STALE line is a real setup failure. buildx is the one thing doctor does not
  # cover that the image builds need.
  local report
  report="$(make --no-print-directory doctor 2>&1)" || true
  printf '%s\n' "${report}"
  if grep -qE '^[[:space:]]+(MISSING|STALE)[[:space:]]' <<<"${report}"; then
    echo "setup: make doctor reports missing or stale tools" >&2
    exit 1
  fi
  docker buildx version >/dev/null
}

require_amd64_debian_12
apt_install_base_tools
install_go
install_uv
install_docker
warm_project_dependencies
verify_tools

echo "ParcelLab Orb tooling is ready. The supervised Docker daemon starts from .agents/resume."
